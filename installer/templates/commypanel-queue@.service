[Unit]
Description=CommyPanel queue worker %i
After=network.target

[Service]
Type=simple
User=commypanel
Group=commypanel
WorkingDirectory=@@PREFIX@@/current
Environment=LARAVEL_STORAGE_PATH=@@DATA_DIR@@/storage
ExecStart=@@PHP_BIN@@ artisan queue:work --tries=1 --timeout=3700 --sleep=2 --max-time=3600
Restart=always
RestartSec=3

NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ReadWritePaths=@@DATA_DIR@@
ProtectKernelTunables=yes
ProtectControlGroups=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
